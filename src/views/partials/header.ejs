<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titleTag %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <script defer src="/scripts/ui-buttons.js"></script>
</head>
<body>
    <header>
        <div class="container">
        <nav class="nav-container">
            <a href="/" class="brand-logo">
                <img src="/images/abel-nonato-profile.webp" alt="nonatoDev Logo" class="brand-avatar">
                <span class="brand-text">nonatoDev<span class="brand-dot">.</span></span>
            </a>
            <button id="hamButton" class="menu-toggle" aria-expanded="false" aria-label="Open menu">
                <span class="hamburger-box">
                    <span class="hamburger-inner"></span>
                </span>
            </button>
            <div class="main-menu" id="mainMenu">
                <div class="menu-controls">
                <button id="themeToggle" class="menu-toggle" aria-label="switch theme">
                    <span class="icon-sun">☀️</span>
                    <span class="icon-moon">🌙</span>
                </button>
                <div class="lng-btn-cont" >
                    <a class="lng-btn active" href="/change-lang/es" style="text-decoration: none;">🇪🇸 ES</a> | 
                    <a class="lng-btn" href="/change-lang/en" style="text-decoration: none;">🇺🇸 EN</a>
                </div>
                </div>    
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/services">Services</a></li>
                    <li><a href="/projects">Projects</a></li>
                </ul>
            </div>    
            </nav>
        </div>
    </header>